# OSTA Job Portal - React Frontend Environment Configuration

# API Configuration
REACT_APP_API_URL=http://localhost/osta_job_portal
REACT_APP_API_TIMEOUT=10000

# File Upload Configuration
REACT_APP_UPLOAD_MAX_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Application Configuration
REACT_APP_NAME=OSTA Job Portal
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Security Configuration
REACT_APP_SESSION_TIMEOUT=3600000
REACT_APP_CSRF_ENABLED=true

# UI Configuration
REACT_APP_ITEMS_PER_PAGE=10
REACT_APP_PAGINATION_RANGE=5

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_FILE_PREVIEW=true

# Development Configuration
REACT_APP_DEBUG_MODE=false
REACT_APP_MOCK_API=false
